{
  "name": "abyssal-wake-relay",
  "main": "cloudflare/src/index.js",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "assets": {
    "directory": "./.cloudflare-site-70653cf1b9da",
    "run_worker_first": ["/health", "/ws"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WORLD",
        "class_name": "GameWorld"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameWorld"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
